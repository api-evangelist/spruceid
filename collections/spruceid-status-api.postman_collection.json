      "item": [
        {
          "id": "f12ebadb-861f-4f2b-9d3d-ee91b062cc43",
          "name": "Get Bitstring Status List Credential",
          "request": {
            "name": "Get Bitstring Status List Credential",
            "description": {
              "content": "Returns a W3C Bitstring Status List verifiable credential that can be used to check the revocation status of credentials issued by this server. The status list encodes credential status as a compressed bitstring. Each credential references a position in this list via a BitstringStatusListEntry credentialStatus property.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "statuslist"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
